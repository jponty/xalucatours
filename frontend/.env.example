REACT_APP_BACKEND_URL=http://127.0.0.1:8001

# Optional and reversible. When set, canonical /api/files relationships are
# delivered directly by Bunny CDN/Optimizer. Remove it to use the API proxy.
REACT_APP_MEDIA_CDN_URL=https://xalucatours-media.b-cdn.net

# Chatbase remains installed and configured, but its floating widget is hidden
# by default. Set to true and rebuild the frontend to show it again.
REACT_APP_CHATBASE_WIDGET_ENABLED=false
