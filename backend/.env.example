# Supabase remains the operational database and reversible storage fallback.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=xaluca

# Media storage cutover: supabase | dual | bunny
MEDIA_STORAGE_PROVIDER=supabase
BUNNY_STORAGE_ZONE=xalucatours-media
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=de
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_CDN_URL=https://xalucatours-media.b-cdn.net
BUNNY_PULL_ZONE_NAME=xalucatours-media

# Administration
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Public deployment URLs
CORS_ORIGINS=https://xalucatravel.com,https://www.xalucatravel.com,https://YOUR_FRONTEND.onrender.com
PUBLIC_SITE_URL=https://YOUR_FRONTEND.onrender.com
PRODUCTION_BASE_URL=https://YOUR_FRONTEND.onrender.com

# Lead notifications
RESEND_API_KEY=
# Full-access key used only to create/update Resend Contacts for the newsletter.
# XALUCA_TOURS_NEWSLETTER is the preferred Render name; the generic alias is
# also supported for other environments. Configure one of the two.
XALUCA_TOURS_NEWSLETTER=
RESEND_CONTACTS_API_KEY=
# Optional but recommended: Resend Segment that receives newsletter signups.
RESEND_NEWSLETTER_SEGMENT_ID=
LEADS_FROM_EMAIL=
LEADS_NOTIFY_EMAILS=
FOUNDER_LLUIS_EMAIL=
FOUNDER_TAYEB_EMAIL=
TEAM_NOEMI_EMAIL=
TEAM_ELENA_EMAIL=
TEAM_SANAA_EMAIL=

# Stock photography integrations
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=Xaluca Tours

# Optional CMS translation
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Resource-intensive maintenance is manual by default.
IMG_WARM_ON_STARTUP=false
IMG_REOPT_ON_STARTUP=false
